# NOTE: For the media-docker project services, you need to create the following 8 env files:
# .env.client            : media-docker-client
# .env.server            : media-docker-server
# .env.video             : media-docker-video-consumer
# .env.video-resolutions : media-docker-video-resolutions-consumer
# .env.audio             : media-docker-audio-consumer
# .env.image             : media-docker-image-consumer
# .env.delete            : media-docker-delete-consumer
# .env.failed            : media-docker-failed-consumer
#
# Since v4 each consumer is its own service owning a single Kafka topic, so each
# one gets its own env file and its own worker count. This is what allows a
# backlog of video transcodes to be scaled up without also scaling image or
# audio processing.
#
# CAUTION: KAFKA_WORKERS for a service must not exceed the partition count of
# that service's topic, summed across every running instance of it. Workers
# beyond the partition count are never assigned a partition and idle forever.
# Partition counts are declared in ./kafka_config.sh.




# ----- create `.env.client` file ----- #

# Client environment config
ENVIRONMENT=development
# Allowed origins for CORS (front-end URLs)
ALLOWED_ORIGINS_CLIENT=http://localhost:5173,http://localhost:4173
# Client service port
CLIENT_PORT=7000




# ----- create `.env.server` file ----- #

# Server environment config
ENVIRONMENT=development
# Allowed origins for CORS (back-end URLs)
ALLOWED_ORIGINS_SERVER=http://localhost:5000,http://localhost:5005
# Authentication key for the server
SERVER_KEY=your_secure_key
# Kafka brokers list separated by commas (for Docker use <service-name>:<port>)
KAFKA_BROKERS=localhost:9092
# Server port
SERVER_PORT=7007
# Base URL for the client
# This URL is used to build the fileUrl returned by upload responses, which
# points at the media-docker-client resolver (e.g. http://localhost:7000/media/videos/<id>).
BASE_URL=http://localhost:7000




# ----- create `.env.video` file ----- #
# media-docker-video-consumer, topic "video"

ENVIRONMENT=development
KAFKA_BROKERS=localhost:9092
KAFKA_WORKERS=1




# ----- create `.env.video-resolutions` file ----- #
# media-docker-video-resolutions-consumer, topic "video-resolutions"
#
# NOTE: each message here is one transcode per rung of the resolution ladder,
# so this service does roughly four times the work per message that the video
# consumer does. Size it against CPU cores, not against the partition count.

ENVIRONMENT=development
KAFKA_BROKERS=localhost:9092
KAFKA_WORKERS=1




# ----- create `.env.audio` file ----- #
# media-docker-audio-consumer, topic "audio"

ENVIRONMENT=development
KAFKA_BROKERS=localhost:9092
KAFKA_WORKERS=1




# ----- create `.env.image` file ----- #
# media-docker-image-consumer, topic "image"

ENVIRONMENT=development
KAFKA_BROKERS=localhost:9092
KAFKA_WORKERS=1




# ----- create `.env.delete` file ----- #
# media-docker-delete-consumer, topic "delete-file"

ENVIRONMENT=development
KAFKA_BROKERS=localhost:9092
KAFKA_WORKERS=1




# ----- create `.env.failed` file ----- #
# media-docker-failed-consumer, topic "failed-letter-queue"

ENVIRONMENT=development
KAFKA_BROKERS=localhost:9092
KAFKA_WORKERS=1
